# 팀원마다 core.autocrlf 설정이 달라도 저장소에는 항상 LF로 저장한다.
# 줄바꿈 때문에 PR diff가 더러워지는 것을 막는다. (.editorconfig와 같은 방침)
* text=auto

# 줄바꿈을 건드리면 깨지는 파일
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.jar binary

# 자동 생성 파일은 리뷰 diff에서 접어 둔다
package-lock.json -diff linguist-generated
web/src/api/schema.d.ts -diff linguist-generated
